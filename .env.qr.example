# Add to your local ROOT .env file. DO NOT commit your actual .env.
# Use a new password (at least 12 characters). No default password is enabled.
QR_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
# Generate with: openssl rand -hex 32
QR_SESSION_SECRET=REPLACE_WITH_GENERATED_RANDOM_64_HEX_CHARACTERS
# For phone scanning, change to publicly reachable HTTPS site before deployment.
QR_PUBLIC_BASE_URL=http://localhost:3000
